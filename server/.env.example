# ============================================================
#  SYNTAX 4 — Server Environment Variables
# ============================================================
#
# Copy this file to .env and fill in your values.
# NEVER commit .env or your service account JSON to git.
# ============================================================

# --- Firebase ---
#
# STEP 1: Go to https://console.firebase.google.com
# STEP 2: Create a project (or select an existing one)
# STEP 3: Go to Project Settings → Service Accounts
# STEP 4: Click "Generate new private key" → save the JSON file
# STEP 5: Place the JSON file in the server/ folder (e.g. serviceAccountKey.json)
# STEP 6: Set the path below (relative to server/)

FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# If you prefer to embed credentials directly (e.g. for Render / Railway):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# --- Server ---
PORT=5000
